<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{F5A5F407-E921-49ED-9CDD-842E02CB9B7B}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>CartridgeShelf</RootNamespace>
    <AssemblyName>CartridgeShelf</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <!-- La sortie de compilation va directement a la racine du projet,
         la ou Playnite attend CartridgeShelf.dll. C'est sans danger vis-a-vis
         d'un Clean Solution : extension.yaml et les .csv sont declares en
         None plus bas (pas Content), donc jamais consideres comme sortie de
         build a nettoyer. -->
