    <Compile Include="Services\ScreenScraperSystemIds.cs" />
    <Compile Include="Services\LibretroThumbnailsClient.cs" />
    <Compile Include="Services\LibretroThumbnailSystems.cs" />
    <Compile Include="Services\SteamGridDbClient.cs" />
  </ItemGroup>
  <ItemGroup>
