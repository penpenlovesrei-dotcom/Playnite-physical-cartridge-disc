<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{F5A5F407-E921-49ED-9CDD-842E02CB9B7B}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>CartridgeShelf</RootNamespace>
    <AssemblyName>CartridgeShelf</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <!-- La sortie de compilation va directement a la racine du projet,
         la ou Playnite attend CartridgeShelf.dll. C'est sans danger vis-a-vis
         d'un Clean Solution : extension.yaml et les .csv sont declares en
         None plus bas (pas Content), donc jamais consideres comme sortie de
         build a nettoyer. -->
    <OutputPath>.\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="Playnite.SDK">
      <HintPath>C:\Users\frede\AppData\Local\Playnite\Playnite.SDK.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Management" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="CartridgeShelfPlugin.cs" />
    <Compile Include="Core\CartridgeInfo.cs" />
    <Compile Include="Core\CartridgeState.cs" />
    <Compile Include="Core\GameIdentity.cs" />
    <Compile Include="Core\PlatformId.cs" />
    <Compile Include="Database\CsvParser.cs" />
    <Compile Include="Database\CartridgeDatabase.cs" />
    <Compile Include="Database\UserLibrary.cs" />
    <Compile Include="Detectors\ICartridgeDetector.cs" />
    <Compile Include="Detectors\SnOperatorDetector.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Services\CoverDownloader.cs" />
    <Compile Include="Services\CartridgeWatcher.cs" />
    <Compile Include="Services\GameSlotManager.cs" />
    <Compile Include="Services\PlatformResolver.cs" />
    <Compile Include="Services\ScreenScraperClient.cs" />
    <Compile Include="Services\ScreenScraperSystemIds.cs" />
    <Compile Include="Services\LibretroThumbnailsClient.cs" />
    <Compile Include="Services\LibretroThumbnailSystems.cs" />
    <Compile Include="Services\SteamGridDbClient.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- None (pas Content) : ces fichiers vivent deja a leur emplacement
         final (racine de l'extension), donc pas de copie de build a faire
         dessus ; ca evite tout risque qu'un futur Clean les supprime. -->
    <None Include="extension.yaml" />
    <None Include="Database\Snes.csv" />
    <None Include="Database\UserLibrary.csv" />
    <None Include="Database\ScreenScraperCredentials.csv" />
    <None Include="Database\SteamGridDbCredentials.csv" />
    <None Include="Assets\no_cartridge.png" Condition="Exists('Assets\no_cartridge.png')" />
    <None Include="packages.config" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Playnite charge l'extension depuis le dossier utilisateur (Roaming),
       nomme d'apres l'Id du plugin, et NON depuis ce dossier-ci. Sans cette
       copie, le binaire charge peut rester perime sans qu'aucune erreur ne
       le signale.
       On redeploie l'extension ENTIERE, pas seulement l'assembly : tout
       fichier omis ici reste fige a sa version du jour de l'installation.
       C'est ce qui est arrive a extension.yaml, qui annoncait encore 0.1
       dans le journal de Playnite pendant que la DLL executee etait celle
       de 0.2. -->
  <Target Name="CopyToPlayniteUserExtensions" AfterTargets="Build">
    <PropertyGroup>
      <PlayniteUserExtension>$(AppData)\Playnite\Extensions\a1312fcb-7107-4168-95ba-181dd6069299</PlayniteUserExtension>
    </PropertyGroup>
    <ItemGroup>
      <DeployRoot Include="extension.yaml" />
      <DeployRoot Include="$(OutputPath)$(AssemblyName).dll" />
      <DeployRoot Include="$(OutputPath)$(AssemblyName).pdb" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
      <DeployDatabase Include="Database\*.csv;Database\*.txt" />
      <!-- Etat de l'utilisateur, jamais ecrase par une compilation : les
           cles d'API qu'il a saisies, et le gabarit de bibliotheque perso
           (ses vraies donnees vivent dans ExtensionsData). -->
      <DeployDatabase Remove="Database\*Credentials.csv" />
      <DeployDatabase Remove="Database\UserLibrary.csv" />
      <DeployAssets Include="Assets\*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployRoot)"
          DestinationFolder="$(PlayniteUserExtension)"
          Condition="Exists('$(PlayniteUserExtension)')"
          ContinueOnError="true" />
    <Copy SourceFiles="@(DeployDatabase)"
          DestinationFolder="$(PlayniteUserExtension)\Database"
          Condition="Exists('$(PlayniteUserExtension)')"
          ContinueOnError="true" />
    <Copy SourceFiles="@(DeployAssets)"
          DestinationFolder="$(PlayniteUserExtension)\Assets"
          Condition="Exists('$(PlayniteUserExtension)')"
          ContinueOnError="true" />
  </Target>
</Project>
